package layouts_view

import (
	"fmt"
	"time"
)

type StaticHomeData struct {
	LoggedUser   bool
	BuildVersion string
	BuildTime    string
	GitSHA       string
}

templ StaticHome(d StaticHomeData) {
	@Base() {
		<div id="content" class="flex justify-center self-center mt-10 w-full xl:w-8/12">
			<div id="side" class="overflow-hidden w-1/3 border-r lg:w-2/12 mr-1/12">
				<hr class="my-5 w-11/12"/>
				<ul>
					<li class="list-none hover:text-gray-500">
						<a href="/reads">
							Reads
						</a>
					</li>
					<li class="list-none hover:text-gray-500">
						<a href="/bookmarks">
							Bookmarks
						</a>
					</li>
					<li class="list-none hover:text-gray-500">
						<a href="/log">Log</a>
					</li>
					<li class="list-none hover:text-gray-500">
						<a href="/gallery">Gallery</a>
					</li>
					<li class="list-none hover:text-gray-500">
						<a href="/activities">Activities</a>
					</li>
				</ul>
				<hr class="my-5 w-11/12"/>
				if d.LoggedUser {
					<ul>
						<li class="list-none hover:text-gray-500">
							<a href="/birthdays">Birthdays</a>
						</li>
						<li class="list-none hover:text-gray-500">
							<a href="/secrets">*********</a>
						</li>
					</ul>
				}
			</div>
			<div class="flex overflow-hidden flex-col px-10 w-2/3">
				<div
					class="relative mx-auto mb-8 w-full bg-cover min-h-52"
					style="background-image: url(assets/img/banners/banner2.png);
						background-position: 0% 80%;"
				>
					if d.LoggedUser {
						<button onclick="decToHex(this);" class="cursor-pointer absolute left-0 w-1/12 h-1/6"></button>
					}
					<a href="/login" class="absolute right-0 w-1/12 h-1/6"></a>
				</div>
				{ children... }
				<span class="mx-auto text-sm mt-10">
					{ fmt.Sprintf("Version %s (%s) | Last updated at %s", d.BuildVersion, d.GitSHA, formatDate(d.BuildTime)) }
				</span>
			</div>
		</div>
	}
}

func formatDate(stringDate string) string {
	t, err := time.Parse(time.RFC3339, stringDate)
	if err != nil {
		return ""
	}
	return t.Format(time.RFC822)
}
